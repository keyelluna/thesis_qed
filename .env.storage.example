# Copy to .env.storage.local and fill it privately in your local editor.
# Backend only. Never put these variables in React/Vite or share their values.
TEMPLATE_STORAGE_BUCKET=qed-grade-templates
# Backblaze > B2 Cloud Storage > Buckets > qed-grade-templates > Endpoint.
# Include https://, omit bucket name/path. Example format only:
# https://s3.<your-region>.backblazeb2.com
TEMPLATE_STORAGE_ENDPOINT=
# Optional for B2: inferred from endpoint. If set, it must match that region.
# Do not use "auto" for B2. Other S3 providers require their signing region here.
TEMPLATE_STORAGE_REGION=
# Backblaze keyID:
TEMPLATE_STORAGE_ACCESS_KEY_ID=
# Backblaze applicationKey:
TEMPLATE_STORAGE_SECRET_ACCESS_KEY=
